# ---------------------------------------------------------------------------
# Développement local (fichier .env) et production (contenu du secret
# COURSES_ENV_FILE, recopié dans /docker/courses/.env à chaque déploiement).
# ---------------------------------------------------------------------------

# Mot de passe du site. Il n'y a qu'un seul compte, donc pas d'identifiant.
NUXT_COURS_MOT_DE_PASSE=change-moi

# Clé de scellement du cookie de session, 32 caractères minimum.
# Générer avec : openssl rand -base64 32
NUXT_SESSION_PASSWORD=change-moi-32-caracteres-minimum-svp

# Emplacement de la base. En conteneur, c'est le volume nommé : /data/cours.sqlite
NUXT_BASE_FICHIER=.data/cours.sqlite

# À laisser à false en local. En production, Caddy réécrit X-Forwarded-For.
NUXT_TRUST_PROXY=false

# Cookie de session réservé à HTTPS. false en local, true derrière Caddy.
NUXT_SESSION_COOKIE_SECURE=false

# --- production seulement ---------------------------------------------------

# Le nom d'hôte que Caddy sert, et pour lequel il demande un certificat.
# Il doit avoir un enregistrement A vers l'IP du VPS avant le déploiement.
COURS_ADRESSE=srv1355415.hstgr.cloud

# Adresse de contact Let's Encrypt (facultative mais recommandée).
ACME_EMAIL=
